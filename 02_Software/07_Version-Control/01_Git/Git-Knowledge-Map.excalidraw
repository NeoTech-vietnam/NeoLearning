    {
      "id": "remote-text",
      "type": "text",
      "x": 1217,
      "y": 396,
      "width": 275,
      "height": 210,
      "angle": 0,
      "strokeColor": "#7d1a3c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
