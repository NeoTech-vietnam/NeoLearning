    {
      "id": "daily-text",
      "type": "text",
      "x": 457,
      "y": 396,
      "width": 280,
      "height": 210,
      "angle": 0,
      "strokeColor": "#155724",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
