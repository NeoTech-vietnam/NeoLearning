      "link": null,
      "locked": false,
      "fontSize": 21,
      "fontFamily": 2,
      "text": "DÒNG CỘNG TÁC CỦA NHÓM\n\nChọn nhánh cơ sở\n        ↓\nTạo nhánh công việc\n        ↓\nThay đổi → kiểm tra → commit rõ ràng\n        ↓\nPush nhánh → mở pull request\n        ↓\nReview + CI + quy tắc nhánh\n        ↓\nMerge theo chính sách repository",
      "originalText": "DÒNG CỘNG TÁC CỦA NHÓM\n\nChọn nhánh cơ sở\n        ↓\nTạo nhánh công việc\n        ↓\nThay đổi → kiểm tra → commit rõ ràng\n        ↓\nPush nhánh → mở pull request\n        ↓\nReview + CI + quy tắc nhánh\n        ↓\nMerge theo chính sách repository",
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
