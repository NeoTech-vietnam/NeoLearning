    {
      "id": "safety-text",
      "type": "text",
      "x": 78,
      "y": 746,
      "width": 410,
      "height": 200,
      "angle": 0,
      "strokeColor": "#3b2469",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a12",
      "roundness": null,
      "seed": 13,
      "version": 1,
      "versionNonce": 13,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788602472196,
      "link": null,
      "locked": false,
      "fontSize": 21,
      "fontFamily": 2,
      "text": "SAFETY PRINCIPLES THROUGHOUT\n\n1. Run status before an impactful action\n2. Review diff before stage, commit, pull, push\n3. Stage reviewed paths only\n4. Never commit tokens, passwords, private keys\n5. Back up important content before restore\n6. Use a new commit to correct shared history\n7. Stop and ask the team when unsure",
      "originalText": "SAFETY PRINCIPLES THROUGHOUT\n\n1. Run status before an impactful action\n2. Review diff before stage, commit, pull, push\n3. Stage reviewed paths only\n4. Never commit tokens, passwords, private keys\n5. Back up important content before restore\n6. Use a new commit to correct shared history\n7. Stop and ask the team when unsure",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
