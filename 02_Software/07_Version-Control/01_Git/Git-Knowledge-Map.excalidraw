    {
      "id": "branches-text",
      "type": "text",
      "x": 837,
      "y": 396,
      "width": 275,
      "height": 210,
      "angle": 0,
      "strokeColor": "#7c3f00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 9,
      "version": 1,
      "versionNonce": 9,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788602472196,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 2,
      "text": "3. NHÁNH & TÍCH HỢP\n\n• Nhánh = dòng công việc cô lập\n• Đặt tên theo quy ước nhóm\n• Merge: giữ lịch sử đã chia sẻ\n• Rebase: viết lại commit cục bộ\n• Conflict: hiểu cả hai ý định\n• Nhánh bảo vệ + review\n\nKhông rebase/force push tùy tiện",
      "originalText": "3. NHÁNH & TÍCH HỢP\n\n• Nhánh = dòng công việc cô lập\n• Đặt tên theo quy ước nhóm\n• Merge: giữ lịch sử đã chia sẻ\n• Rebase: viết lại commit cục bộ\n• Conflict: hiểu cả hai ý định\n• Nhánh bảo vệ + review\n\nKhông rebase/force push tùy tiện",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
