      "link": null,
      "locked": false,
      "fontSize": 21,
      "fontFamily": 2,
      "text": "TEAM COLLABORATION FLOW\n\nChoose the base branch\n        ↓\nCreate a work branch\n        ↓\nChange → inspect → clear commit\n        ↓\nPush branch → open pull request\n        ↓\nReview + CI + branch rules\n        ↓\nMerge by repository policy",
      "originalText": "TEAM COLLABORATION FLOW\n\nChoose the base branch\n        ↓\nCreate a work branch\n        ↓\nChange → inspect → clear commit\n        ↓\nPush branch → open pull request\n        ↓\nReview + CI + branch rules\n        ↓\nMerge by repository policy",
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
