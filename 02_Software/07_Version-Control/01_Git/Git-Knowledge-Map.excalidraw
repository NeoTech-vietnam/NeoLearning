      "seed": 7,
      "version": 1,
      "versionNonce": 7,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788602472196,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 2,
      "text": "2. DAILY CHANGES\n\n1. status — establish context\n2. diff — preview changes\n3. add — select deliberately\n4. diff --staged — inspect\n5. commit — one clear purpose\n6. log — verify history\n\n.gitignore ≠ secret protection",
      "originalText": "2. DAILY CHANGES\n\n1. status — establish context\n2. diff — preview changes\n3. add — select deliberately\n4. diff --staged — inspect\n5. commit — one clear purpose\n6. log — verify history\n\n.gitignore ≠ secret protection",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "branches-box",
