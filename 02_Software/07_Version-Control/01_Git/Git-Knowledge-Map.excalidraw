    {
      "id": "safety-text",
      "type": "text",
      "x": 78,
      "y": 746,
      "width": 410,
      "height": 200,
      "angle": 0,
      "strokeColor": "#3b2469",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a12",
      "roundness": null,
      "seed": 13,
      "version": 1,
      "versionNonce": 13,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788602472196,
      "link": null,
      "locked": false,
      "fontSize": 21,
      "fontFamily": 2,
      "text": "NGUYÊN TẮC AN TOÀN XUYÊN SUỐT\n\n1. status trước thao tác có tác động\n2. diff trước stage, commit, pull, push\n3. Stage theo đường dẫn đã xem xét\n4. Không commit token, mật khẩu, private key\n5. Sao lưu nội dung quan trọng trước restore\n6. Commit mới để sửa lịch sử đã chia sẻ\n7. Dừng lại, hỏi nhóm khi chưa hiểu",
      "originalText": "NGUYÊN TẮC AN TOÀN XUYÊN SUỐT\n\n1. status trước thao tác có tác động\n2. diff trước stage, commit, pull, push\n3. Stage theo đường dẫn đã xem xét\n4. Không commit token, mật khẩu, private key\n5. Sao lưu nội dung quan trọng trước restore\n6. Commit mới để sửa lịch sử đã chia sẻ\n7. Dừng lại, hỏi nhóm khi chưa hiểu",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
