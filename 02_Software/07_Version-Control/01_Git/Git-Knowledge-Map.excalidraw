    {
      "id": "branches-text",
      "type": "text",
      "x": 837,
      "y": 396,
      "width": 275,
      "height": 210,
      "angle": 0,
      "strokeColor": "#7c3f00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
