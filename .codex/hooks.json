{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .codex/hooks/inject-workflow-state.py",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(?:trellis-implement|trellis-check|trellis-research)$",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .codex/hooks/inject-subagent-context.py",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node 'D:\\workspace\\NeoLearning\\.neomind\\hooks\\codex.cjs' SubagentStop",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand JgAgAG4AbwBkAGUAIAAnAEQAOgBcAHcAbwByAGsAcwBwAGEAYwBlAFwATgBlAG8ATABlAGEAcgBuAGkAbgBnAFwALgBuAGUAbwBtAGkAbgBkAFwAaABvAG8AawBzAFwAYwBvAGQAZQB4AC4AYwBqAHMAJwAgAFMAdQBiAGEAZwBlAG4AdABTAHQAbwBwAA==",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node 'D:\\workspace\\NeoLearning\\.neomind\\hooks\\codex.cjs' PostToolUse",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand JgAgAG4AbwBkAGUAIAAnAEQAOgBcAHcAbwByAGsAcwBwAGEAYwBlAFwATgBlAG8ATABlAGEAcgBuAGkAbgBnAFwALgBuAGUAbwBtAGkAbgBkAFwAaABvAG8AawBzAFwAYwBvAGQAZQB4AC4AYwBqAHMAJwAgAFAAbwBzAHQAVABvAG8AbABVAHMAZQA=",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node 'D:\\workspace\\NeoLearning\\.neomind\\hooks\\codex.cjs' Stop",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand JgAgAG4AbwBkAGUAIAAnAEQAOgBcAHcAbwByAGsAcwBwAGEAYwBlAFwATgBlAG8ATABlAGEAcgBuAGkAbgBnAFwALgBuAGUAbwBtAGkAbgBkAFwAaABvAG8AawBzAFwAYwBvAGQAZQB4AC4AYwBqAHMAJwAgAFMAdABvAHAA",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
