{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .codex/hooks/inject-workflow-state.py",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(?:trellis-implement|trellis-check|trellis-research)$",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .codex/hooks/inject-subagent-context.py",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'C:\\Program Files\\nodejs\\node.exe' 'D:\\workspace\\NeoLearning\\node_modules\\verythinker\\dist\\cli.js' 'hook' '--event' 'session-start' '--platform' 'codex' '--project' 'D:\\workspace\\NeoLearning'",
            "commandWindows": "& 'C:\\Program Files\\nodejs\\node.exe' 'D:\\workspace\\NeoLearning\\node_modules\\verythinker\\dist\\cli.js' 'hook' '--event' 'session-start' '--platform' 'codex' '--project' 'D:\\workspace\\NeoLearning'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'C:\\Program Files\\nodejs\\node.exe' 'D:\\workspace\\NeoLearning\\node_modules\\verythinker\\dist\\cli.js' 'hook' '--event' 'after-tool' '--platform' 'codex' '--project' 'D:\\workspace\\NeoLearning'",
            "commandWindows": "& 'C:\\Program Files\\nodejs\\node.exe' 'D:\\workspace\\NeoLearning\\node_modules\\verythinker\\dist\\cli.js' 'hook' '--event' 'after-tool' '--platform' 'codex' '--project' 'D:\\workspace\\NeoLearning'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'C:\\Program Files\\nodejs\\node.exe' 'D:\\workspace\\NeoLearning\\node_modules\\verythinker\\dist\\cli.js' 'hook' '--event' 'stop' '--platform' 'codex' '--project' 'D:\\workspace\\NeoLearning'",
            "commandWindows": "& 'C:\\Program Files\\nodejs\\node.exe' 'D:\\workspace\\NeoLearning\\node_modules\\verythinker\\dist\\cli.js' 'hook' '--event' 'stop' '--platform' 'codex' '--project' 'D:\\workspace\\NeoLearning'",
            "timeout": 10
          }
        ]
