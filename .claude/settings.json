{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Program Files\\nodejs\\node.exe",
            "args": [
              "D:\\workspace\\NeoLearning\\node_modules\\verythinker\\dist\\cli.js",
              "hook",
              "--event",
